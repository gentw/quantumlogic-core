APP_NAME=QuantumLogic
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

# Feature modules. The security module (domains, alarms, threat logs) is dormant.
# Read docs/modules/security/README.md before switching it on.
FEATURE_SECURITY_MODULE=false
# The SaaS plan-tier subscription system is retired — Billing & Payments replaced it.
# Read docs/modules/subscriptions/README.md before switching it on.
FEATURE_SUBSCRIPTION_PLANS=false

# Two-factor login codes (config/two_factor.php). Which roles start with it
# switched on lives in that file, not here.
TWO_FACTOR_CODE_TTL=10

# Language (config/locale.php). Supported locales and the country → locale map
# live in that file, not here.
#
# Optional: a MaxMind GeoLite2-Country database, consulted only when a request
# arrives without Cloudflare's CF-IPCountry header. Behind Cloudflare it is not
# needed at all. Requires `composer require geoip2/geoip2` plus the .mmdb file —
# LocaleService skips the lookup when either is missing.
# GEOIP_DATABASE_PATH=

# Billing & Payments (config/billing.php)
BILLING_INVOICE_PREFIX=QL
BILLING_PAYMENT_TERMS_DAYS=14
BILLING_SELLER_COUNTRY=AT
BILLING_VAT_RATE=20
BILLING_VIES_LIVE_CHECK=false

# Stripe (config/stripe.php)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal webhook for Billing & Payments (config/paypal.php)
PAYPAL_WEBHOOK_ID=

# Company identity — invoice legal footer + SEPA transfer (config/company.php)
COMPANY_LEGAL_NAME=QuantumLogic
COMPANY_ADDRESS=
COMPANY_UID=
COMPANY_REGISTER_NO=
COMPANY_REGISTER_COURT=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_IBAN=
COMPANY_BIC=
COMPANY_BANK_NAME=
# EPC069-12 Giro-Code on invoices and every bank-transfer screen. Keep it off
# until COMPANY_IBAN/COMPANY_BIC above are real — a QR built from blank
# details scans fine and produces a broken transfer.
BILLING_EPC_QR=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
