# Base URL for the Laravel backend (no trailing slash).
# The $api ofetch client in src/utils/api.js prepends this to every request,
# so route paths in code stay relative (e.g. '/v1/client/sub/startTrial').
VITE_API_BASE_URL=https://api-ds.bitemybytes.com/api

# Feature modules — must match FEATURE_SECURITY_MODULE in api/.env.
# The security module (domains, alarms, threat logs) is dormant.
# Read docs/modules/security/README.md before switching it on.
VITE_FEATURE_SECURITY_MODULE=false

# Must match FEATURE_SUBSCRIPTION_PLANS in api/.env. The SaaS plan-tier
# subscription system is retired — Billing & Payments replaced it.
# Read docs/modules/subscriptions/README.md before switching it on.
VITE_FEATURE_SUBSCRIPTION_PLANS=false

# Stripe publishable key (pk_...) — pairs with STRIPE_KEY/SECRET in api/.env
VITE_STRIPE_PUBLISHABLE_KEY=

# Pusher (must match api/.env)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=

# Firebase Cloud Messaging (web push)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
